<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/dlu_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_dlu_splash</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/dlu_brand_blue</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/dlu_splash_background</item>
        <item name="android:navigationBarColor">@color/dlu_splash_background</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
